# API
PORT=3000

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=ai_agents

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXECUTIONS_QUEUE=agent-executions
RABBITMQ_PREFETCH=5
# Tempo máximo para a confirmação de uma publicação (ms)
RABBITMQ_PUBLISH_TIMEOUT_MS=5000
# Total de tentativas, incluindo a primeira (1 a 100)
RABBITMQ_MAX_ATTEMPTS=3
# Intervalo antes de republicar uma mensagem que falhou (ms)
RABBITMQ_RETRY_DELAY_MS=1000

# Worker
# Latência simulada do processamento de uma execução (ms)
PROCESSING_DELAY_MS=2000
